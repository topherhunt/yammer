# Postgres connection string for this app's database (see plan.md sec 15).
DATABASE_URL=postgres://user:password@localhost:5432/yammer_dev

# OpenAI: GPT-5.6 (Luna dev / Terra prod) + Realtime STT proxy.
OPENAI_API_KEY=

# Tavily: default web-search provider for the research pipeline.
TAVILY_API_KEY=

# Google OAuth (Sign in with Google) -- one users row per login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign HTTP-only session cookies.
SESSION_SECRET=

# Optional overrides.
# PORT=3141   # dev default (chosen to avoid Rails' 3000)
# LLM_MODEL=gpt-5.6-luna
# LLM_REASONING_EFFORT=low         # low|medium|high. low = much lower turn latency; raise if action accuracy slips
# STT_MODEL=gpt-realtime-whisper   # streaming transcription model for the WS proxy

# Diagnostics (verbose, off by default; turn on to capture ground truth for a bug report).
# YAMMER_TURN_DEBUG=1              # log each turn's transcript, LLM latency (ms), and the RAW model response
# YAMMER_STT_DEBUG=1              # log the STT session config + every event OpenAI returns over the WS
# When either flag is on, output goes to the terminal AND to a JSONL file (default
# yammer-debug.log at the repo root, gitignored) so it can be inspected after the fact.
# YAMMER_DEBUG_LOG=/abs/path/yammer-debug.log   # override the debug-log file path

# STT WebSocket proxy cost + lifecycle caps (open sockets bill ~$0.017/min).
# All optional; the defaults below are applied when unset.
# STT_MAX_SESSION_MS=600000        # hard ceiling on one session (10 min) -> closes "max_duration"
# STT_IDLE_TIMEOUT_MS=30000        # close after 30s with no audio -> closes "idle_timeout"
# STT_MAX_TOTAL_BYTES=33554432     # cumulative audio budget, 32 MiB (~11 min PCM16) -> "byte_budget"
# STT_MAX_FRAME_BYTES=1048576      # reject any single audio frame over 1 MiB -> "byte_budget"
# STT_MAX_SOCKETS_PER_USER=3       # max concurrent STT sockets per user
